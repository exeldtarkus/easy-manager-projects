			},
			{
				"command": "lemari.addToFavorites",
				"title": "%lemari.commands.addToFavorites.title%"
			},
			{
				"command": "_lemari.toggleProjectEnabled",
				"title": "%lemari.commands.toggleProjectEnabled.title%"
			},
			{
				"command": "lemari.hideGitWelcome",
				"title": "%lemari.commands.hideGitWelcome.title%"
			},
			{
				"command": "lemari.showGitWelcome",
				"title": "%lemari.commands.showGitWelcome.title%"
			},
			{
				"command": "_lemari.openFolderWelcome",
				"title": "%lemari.commands.openFolderWelcome.title%"
			},
			{
				"command": "lemari.supportProjectManager",
				"title": "%lemari.commands.supportProjectManager.title%"
			},
			{
				"command": "_lemari.openSideBar",
				"title": "%lemari.commands.openSideBar.title%"
			}
		],
