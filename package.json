{
	"name": "lemari",
	"displayName": "Lemari - Project Manager",
	"description": "Easily switch between projects, including opening projects in WSL or Windows (fork of alefragnani's Project Manager)",
	"version": "1.10.4",
	"publisher": "exeltarkus",
	"engines": {
		"vscode": "^1.78.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"project",
		"folder",
		"workspace",
		"switch",
		"manage",
		"mercurial",
		"svn",
		"multi-root ready"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"icon": "docs/images/icon.png",
	"license": "SEE LICENSE IN LICENSE.md",
	"homepage": "https://github.com/exeldtarkus/lemari/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/exeldtarkus/lemari.git"
	},
	"bugs": {
		"url": "https://github.com/exeldtarkus/lemari/issues"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension",
	"l10n": "./l10n",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "easy-manager-projects",
					"title": "%easyManagerProjects.activitybar.title%",
					"icon": "docs/images/project-manager-side-bar.svg"
				}
			]
		},
		"views": {
			"easy-manager-projects": [
				{
					"id": "easyManagerProjectsExplorerFavorites",
					"name": "%easyManagerProjects.views.favorites.name%"
				},
				{
					"id": "easyManagerProjectsExplorerGit",
					"name": "%easyManagerProjects.views.git.name%",
					"when": "easyManagerProjects.canShowTreeViewGit"
				},
				{
					"id": "easyManagerProjectsExplorerSVN",
					"name": "%easyManagerProjects.views.svn.name%",
					"when": "easyManagerProjects.canShowTreeViewSVN"
				},
				{
					"id": "easyManagerProjectsExplorerAny",
					"name": "%easyManagerProjects.views.any.name%",
					"when": "easyManagerProjects.canShowTreeViewAny"
				},
				{
					"id": "easyManagerProjectsExplorerMercurial",
					"name": "%easyManagerProjects.views.mercurial.name%",
					"when": "easyManagerProjects.canShowTreeViewMercurial"
				},
				{
					"id": "easyManagerProjectsExplorerVSCode",
					"name": "%easyManagerProjects.views.vscode.name%",
					"when": "easyManagerProjects.canShowTreeViewVSCode"
				},
				{
					"id": "easyManagerProjectsHelpAndFeedback",
					"name": "%easyManagerProjects.views.helpAndFeedback.name%",
					"visibility": "collapsed"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "easyManagerProjectsExplorerFavorites",
				"contents": "%easyManagerProjects.viewsWelcome.favorites.contents.whenEmpty%",
				"when": "workbenchState == empty"
			},
			{
				"view": "easyManagerProjectsExplorerFavorites",
				"contents": "%easyManagerProjects.viewsWelcome.favorites.contents.whenNotEmpty%",
				"when": "workbenchState != empty"
			},
			{
				"view": "easyManagerProjectsExplorerGit",
				"contents": "%easyManagerProjects.viewsWelcome.git.contents%"
			}
		],
		"commands": [
			{
				"command": "easyManagerProjects.saveProject",
				"title": "%easyManagerProjects.commands.saveProject.title%",
				"icon": "$(save)"
			},
			{
				"command": "easyManagerProjects.addFolderToFavorites",
				"title": "%easyManagerProjects.commands.addFolderToFavorites.title%",
				"icon": "$(new-folder)"
			},
			{
				"command": "easyManagerProjects.listProjects",
				"title": "%easyManagerProjects.commands.listProjects.title%"
			},
			{
				"command": "easyManagerProjects.listProjectsNewWindow",
				"title": "%easyManagerProjects.commands.listProjectsNewWindow.title%"
			},
			{
				"command": "easyManagerProjects.editProjects",
				"title": "%easyManagerProjects.commands.editProjects.title%",
				"icon": "$(edit)"
			},
			{
				"command": "_easyManagerProjects.viewAsTags#sideBarFavorites",
				"title": "%easyManagerProjects.commands.viewAsTags#sideBarFavorites.title%",
				"icon": "$(list-tree)",
				"enablement": "easyManagerProjects.viewAsList"
			},
			{
				"command": "_easyManagerProjects.viewAsList#sideBarFavorites",
				"title": "%easyManagerProjects.commands.viewAsList#sideBarFavorites.title%",
				"icon": "$(list-flat)",
				"enablement": "!easyManagerProjects.viewAsList"
			},
			{
				"command": "_easyManagerProjects.sortBySaved#sideBarFavorites",
				"title": "%easyManagerProjects.commands.sortBySaved#sideBarFavorites.title%",
				"enablement": "easyManagerProjects.sortBy != Saved"
			},
			{
				"command": "_easyManagerProjects.sortByName#sideBarFavorites",
				"title": "%easyManagerProjects.commands.sortByName#sideBarFavorites.title%",
				"enablement": "easyManagerProjects.sortBy != Name"
			},
			{
				"command": "_easyManagerProjects.sortByPath#sideBarFavorites",
				"title": "%easyManagerProjects.commands.sortByPath#sideBarFavorites.title%",
				"enablement": "easyManagerProjects.sortBy != Path"
			},
			{
				"command": "_easyManagerProjects.sortByRecent#sideBarFavorites",
				"title": "%easyManagerProjects.commands.sortByRecent#sideBarFavorites.title%",
				"enablement": "easyManagerProjects.sortBy != Recent"
			},
			{
				"command": "easyManagerProjects.filterProjectsByTag",
				"title": "%easyManagerProjects.commands.filterProjectsByTag.title%"
			},
			{
				"command": "easyManagerProjects.filterProjectsByTag#sideBar",
				"title": "%easyManagerProjects.commands.filterProjectsByTag#sideBar.title%",
				"icon": "$(tag)"
			},
			{
				"command": "easyManagerProjects.listFavoriteProjects#sideBarFavorites",
				"title": "%easyManagerProjects.commands.listFavoriteProjects#sideBarFavorites.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.refreshProjects",
				"title": "%easyManagerProjects.commands.refreshProjects.title%"
			},
			{
				"command": "easyManagerProjects.refreshVSCodeProjects",
				"title": "%easyManagerProjects.commands.refreshVSCodeProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "easyManagerProjects.listVSCodeProjects#sideBarVSCode",
				"title": "%easyManagerProjects.commands.listVSCodeProjects#sideBarVSCode.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.refreshGitProjects",
				"title": "%easyManagerProjects.commands.refreshGitProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "easyManagerProjects.addGitBaseFolder",
				"title": "%easyManagerProjects.commands.addGitBaseFolder.title%",
				"icon": "$(new-folder)"
			},
			{
				"command": "easyManagerProjects.listGitProjects#sideBarGit",
				"title": "%easyManagerProjects.commands.listGitProjects#sideBarGit.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.refreshSVNProjects",
				"title": "%easyManagerProjects.commands.refreshSVNProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "easyManagerProjects.listSVNProjects#sideBarSVN",
				"title": "%easyManagerProjects.commands.listSVNProjects#sideBarSVN.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.refreshAnyProjects",
				"title": "%easyManagerProjects.commands.refreshAnyProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "easyManagerProjects.listAnyProjects#sideBarAny",
				"title": "%easyManagerProjects.commands.listAnyProjects#sideBarAny.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.refreshMercurialProjects",
				"title": "%easyManagerProjects.commands.refreshMercurialProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "easyManagerProjects.listMercurialProjects#sideBarMercurial",
				"title": "%easyManagerProjects.commands.listMercurialProjects#sideBarMercurial.title%",
				"icon": "$(search)"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarFavorites",
				"title": "%easyManagerProjects.commands.openSettings#sideBarFavorites.title%"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarVSCode",
				"title": "%easyManagerProjects.commands.openSettings#sideBarVSCode.title%"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarGit",
				"title": "%easyManagerProjects.commands.openSettings#sideBarGit.title%"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarSVN",
				"title": "%easyManagerProjects.commands.openSettings#sideBarSVN.title%"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarAny",
				"title": "%easyManagerProjects.commands.openSettings#sideBarAny.title%"
			},
			{
				"command": "easyManagerProjects.openSettings#sideBarMercurial",
				"title": "%easyManagerProjects.commands.openSettings#sideBarMercurial.title%"
			},
			{
				"command": "_easyManagerProjects.open",
				"title": "%easyManagerProjects.commands.open.title%"
			},
			{
				"command": "_easyManagerProjects.openInNewWindow",
				"title": "%easyManagerProjects.commands.openInNewWindow.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "_easyManagerProjects.openInWsl",
				"title": "%easyManagerProjects.commands.openInWsl.title%"
			},
			{
				"command": "_easyManagerProjects.openInWindows",
				"title": "%easyManagerProjects.commands.openInWindows.title%"
			},
			{
				"command": "easyManagerProjects.addToWorkspace#sideBar",
				"title": "%easyManagerProjects.commands.addToWorkspace#sideBar.title%"
			},
			{
				"command": "_easyManagerProjects.revealInFinder#sideBar",
				"title": "%easyManagerProjects.commands.revealInFinder#sideBar.title%"
			},
			{
				"command": "_easyManagerProjects.revealInExplorer#sideBar",
				"title": "%easyManagerProjects.commands.revealInExplorer#sideBar.title%"
			},
			{
				"command": "_easyManagerProjects.revealInFileManager#sideBar",
				"title": "%easyManagerProjects.commands.revealInFileManager#sideBar.title%"
			},
			{
				"command": "easyManagerProjects.addToWorkspace",
				"title": "%easyManagerProjects.commands.addToWorkspace.title%"
			},
			{
				"command": "_easyManagerProjects.deleteProject",
				"title": "%easyManagerProjects.commands.deleteProject.title%"
			},
			{
				"command": "_easyManagerProjects.renameProject",
				"title": "%easyManagerProjects.commands.renameProject.title%"
			},
			{
				"command": "_easyManagerProjects.editTags",
				"title": "%easyManagerProjects.commands.editTags.title%"
			},
			{
				"command": "_easyManagerProjects.editIcon",
				"title": "%easyManagerProjects.commands.editIcon.title%"
			},
			{
				"command": "_easyManagerProjects.editPath",
				"title": "%easyManagerProjects.commands.editPath.title%"
			},
			{
				"command": "easyManagerProjects.whatsNew",
				"title": "%easyManagerProjects.commands.whatsNew.title%"
			},
			{
				"command": "_easyManagerProjects.whatsNewContextMenu",
				"title": "%easyManagerProjects.commands.whatsNewContextMenu.title%"
			},
			{
				"command": "easyManagerProjects.addToFavorites",
				"title": "%easyManagerProjects.commands.addToFavorites.title%"
			},
			{
				"command": "_easyManagerProjects.toggleProjectEnabled",
				"title": "%easyManagerProjects.commands.toggleProjectEnabled.title%"
			},
			{
				"command": "easyManagerProjects.hideGitWelcome",
				"title": "%easyManagerProjects.commands.hideGitWelcome.title%"
			},
			{
				"command": "easyManagerProjects.showGitWelcome",
				"title": "%easyManagerProjects.commands.showGitWelcome.title%"
			},
			{
				"command": "_easyManagerProjects.openFolderWelcome",
				"title": "%easyManagerProjects.commands.openFolderWelcome.title%"
			},
			{
				"command": "easyManagerProjects.supportProjectManager",
				"title": "%easyManagerProjects.commands.supportProjectManager.title%"
			},
			{
				"command": "_easyManagerProjects.openSideBar",
				"title": "%easyManagerProjects.commands.openSideBar.title%"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "_easyManagerProjects.open",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.openInNewWindow",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.openInWsl",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.openInWindows",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.addToWorkspace#sideBar",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.revealInFinder#sideBar",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.revealInExplorer#sideBar",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.revealInFileManager#sideBar",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.deleteProject",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.renameProject",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.editTags",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.editIcon",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.editPath",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.viewAsTags#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.viewAsList#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.sortBySaved#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.sortByName#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.sortByPath#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.sortByRecent#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.filterProjectsByTag#sideBar",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listFavoriteProjects#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listVSCodeProjects#sideBarVSCode",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listGitProjects#sideBarGit",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listSVNProjects#sideBarSVN",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listAnyProjects#sideBarAny",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.listMercurialProjects#sideBarMercurial",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarVSCode",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarSVN",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarGit",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarAny",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarMercurial",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.whatsNewContextMenu",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.hideGitWelcome",
					"when": "false"
				},
				{
					"command": "easyManagerProjects.showGitWelcome",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.openFolderWelcome",
					"when": "false"
				},
				{
					"command": "_easyManagerProjects.openSideBar",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "easyManagerProjects.addFolderToFavorites",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "navigation@9"
				},
				{
					"command": "easyManagerProjects.saveProject",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.editProjects",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "navigation@11"
				},
				{
					"command": "_easyManagerProjects.viewAsTags#sideBarFavorites",
					"when": "view == easyManagerProjectsExplorerFavorites && easyManagerProjects.viewAsList",
					"group": "navigation@12"
				},
				{
					"command": "_easyManagerProjects.viewAsList#sideBarFavorites",
					"when": "view == easyManagerProjectsExplorerFavorites && !easyManagerProjects.viewAsList",
					"group": "navigation@13"
				},
				{
					"command": "easyManagerProjects.listFavoriteProjects#sideBarFavorites",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "navigation@14"
				},
				{
					"command": "easyManagerProjects.filterProjectsByTag#sideBar",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "navigation@14"
				},
				{
					"submenu": "easyManagerProjects.sideBar.favorites.title",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "1_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarFavorites",
					"when": "view == easyManagerProjectsExplorerFavorites",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.showGitWelcome",
					"when": "view == easyManagerProjectsExplorerFavorites && easyManagerProjects.hiddenGitWelcome",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.listVSCodeProjects#sideBarVSCode",
					"when": "view == easyManagerProjectsExplorerVSCode",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.refreshVSCodeProjects",
					"when": "view == easyManagerProjectsExplorerVSCode",
					"group": "navigation@11"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarVSCode",
					"when": "view == easyManagerProjectsExplorerVSCode",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.addGitBaseFolder",
					"when": "view == easyManagerProjectsExplorerGit",
					"group": "navigation@9"
				},
				{
					"command": "easyManagerProjects.listGitProjects#sideBarGit",
					"when": "view == easyManagerProjectsExplorerGit",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.refreshGitProjects",
					"when": "view == easyManagerProjectsExplorerGit",
					"group": "navigation@11"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarGit",
					"when": "view == easyManagerProjectsExplorerGit",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.listSVNProjects#sideBarSVN",
					"when": "view == easyManagerProjectsExplorerSVN",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.refreshSVNProjects",
					"when": "view == easyManagerProjectsExplorerSVN",
					"group": "navigation@11"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarSVN",
					"when": "view == easyManagerProjectsExplorerSVN",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.listAnyProjects#sideBarAny",
					"when": "view == easyManagerProjectsExplorerAny",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.refreshAnyProjects",
					"when": "view == easyManagerProjectsExplorerAny",
					"group": "navigation@11"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarAny",
					"when": "view == easyManagerProjectsExplorerAny",
					"group": "2_easyManagerProjects"
				},
				{
					"command": "easyManagerProjects.listMercurialProjects#sideBarMercurial",
					"when": "view == easyManagerProjectsExplorerMercurial",
					"group": "navigation@10"
				},
				{
					"command": "easyManagerProjects.refreshMercurialProjects",
					"when": "view == easyManagerProjectsExplorerMercurial",
					"group": "navigation@11"
				},
				{
					"command": "easyManagerProjects.openSettings#sideBarMercurial",
					"when": "view == easyManagerProjectsExplorerMercurial",
					"group": "2_easyManagerProjects"
				}
			],
			"view/item/context": [
				{
					"command": "_easyManagerProjects.openInNewWindow",
					"when": "view =~ /easyManagerProjectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "inline"
				},
				{
					"command": "_easyManagerProjects.open",
					"when": "view =~ /easyManagerProjectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_easyManagerProjects.openInNewWindow",
					"when": "view =~ /easyManagerProjectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_easyManagerProjects.openInWsl",
					"when": "view =~ /easyManagerProjectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation"
				},
				{
					"command": "_easyManagerProjects.openInWindows",
					"when": "view =~ /easyManagerProjectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation"
				},
				{
					"command": "_easyManagerProjects.revealInFinder#sideBar",
