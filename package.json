			"view/title": [
				{
					"command": "lemari.addFolderToFavorites",
					"when": "view == lemariExplorerFavorites",
					"group": "navigation@9"
				},
				{
					"command": "lemari.saveProject",
					"when": "view == lemariExplorerFavorites",
					"group": "navigation@10"
				},
				{
					"command": "lemari.editProjects",
					"when": "view == lemariExplorerFavorites",
					"group": "navigation@11"
				},
				{
					"command": "_lemari.viewAsTags#sideBarFavorites",
					"when": "view == lemariExplorerFavorites && lemari.viewAsList",
					"group": "navigation@12"
				},
				{
					"command": "_lemari.viewAsList#sideBarFavorites",
					"when": "view == lemariExplorerFavorites && !lemari.viewAsList",
					"group": "navigation@13"
				},
				{
					"command": "lemari.listFavoriteProjects#sideBarFavorites",
					"when": "view == lemariExplorerFavorites",
					"group": "navigation@14"
				},
				{
					"command": "lemari.filterProjectsByTag#sideBar",
					"when": "view == lemariExplorerFavorites",
					"group": "navigation@14"
				},
				{
					"submenu": "lemari.sideBar.favorites.title",
					"when": "view == lemariExplorerFavorites",
					"group": "1_lemari"
				},
				{
					"command": "lemari.openSettings#sideBarFavorites",
					"when": "view == lemariExplorerFavorites",
					"group": "2_lemari"
				},
				{
					"command": "lemari.showGitWelcome",
					"when": "view == lemariExplorerFavorites && lemari.hiddenGitWelcome",
					"group": "2_lemari"
				},
				{
					"command": "lemari.listVSCodeProjects#sideBarVSCode",
					"when": "view == lemariExplorerVSCode",
