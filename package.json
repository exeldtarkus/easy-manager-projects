{
	"name": "lemari",
	"displayName": "Lemari - Project Manager",
	"description": "Easily switch between projects, including opening projects in WSL or Windows (fork of alefragnani's Project Manager)",
	"version": "1.11.2",
	"publisher": "exeltarkus",
	"engines": {
		"vscode": "^1.78.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"project",
		"folder",
		"workspace",
		"switch",
		"manage",
		"mercurial",
		"svn",
		"multi-root ready"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"icon": "docs/images/icon.png",
	"license": "SEE LICENSE IN LICENSE.md",
	"homepage": "https://github.com/exeldtarkus/lemari/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/exeldtarkus/lemari.git"
	},
	"bugs": {
		"url": "https://github.com/exeldtarkus/lemari/issues"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension",
	"l10n": "./l10n",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "lemari",
					"title": "%lemari.activitybar.title%",
					"icon": "docs/images/project-manager-side-bar.svg"
				}
			]
		},
		"views": {
			"lemari": [
				{
					"id": "lemariExplorerFavorites",
					"name": "%lemari.views.favorites.name%"
				},
				{
					"id": "lemariExplorerGit",
					"name": "%lemari.views.git.name%",
					"when": "lemari.canShowTreeViewGit"
				},
				{
					"id": "lemariExplorerSVN",
					"name": "%lemari.views.svn.name%",
					"when": "lemari.canShowTreeViewSVN"
				},
				{
					"id": "lemariExplorerAny",
					"name": "%lemari.views.any.name%",
					"when": "lemari.canShowTreeViewAny"
				},
				{
					"id": "lemariExplorerMercurial",
					"name": "%lemari.views.mercurial.name%",
					"when": "lemari.canShowTreeViewMercurial"
				},
				{
					"id": "lemariExplorerVSCode",
					"name": "%lemari.views.vscode.name%",
					"when": "lemari.canShowTreeViewVSCode"
				},
				{
					"id": "lemariHelpAndFeedback",
					"name": "%lemari.views.helpAndFeedback.name%",
					"visibility": "collapsed"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "lemariExplorerFavorites",
				"contents": "%lemari.viewsWelcome.favorites.contents.whenEmpty%",
				"when": "workbenchState == empty"
			},
			{
				"view": "lemariExplorerFavorites",
				"contents": "%lemari.viewsWelcome.favorites.contents.whenNotEmpty%",
				"when": "workbenchState != empty"
			},
			{
				"view": "lemariExplorerGit",
				"contents": "%lemari.viewsWelcome.git.contents%"
			}
		],
		"commands": [
			{
				"command": "lemari.saveProject",
				"title": "%lemari.commands.saveProject.title%",
				"icon": "$(save)"
			},
			{
				"command": "lemari.addFolderToFavorites",
				"title": "%lemari.commands.addFolderToFavorites.title%",
				"icon": "$(new-folder)"
			},
			{
				"command": "lemari.listProjects",
				"title": "%lemari.commands.listProjects.title%"
			},
			{
				"command": "lemari.listProjectsNewWindow",
				"title": "%lemari.commands.listProjectsNewWindow.title%"
			},
			{
				"command": "lemari.editProjects",
				"title": "%lemari.commands.editProjects.title%",
				"icon": "$(edit)"
			},
			{
				"command": "_lemari.viewAsTags#sideBarFavorites",
				"title": "%lemari.commands.viewAsTags#sideBarFavorites.title%",
				"icon": "$(list-tree)",
				"enablement": "lemari.viewAsList"
			},
			{
				"command": "_lemari.viewAsList#sideBarFavorites",
				"title": "%lemari.commands.viewAsList#sideBarFavorites.title%",
				"icon": "$(list-flat)",
				"enablement": "!lemari.viewAsList"
			},
			{
				"command": "_lemari.sortBySaved#sideBarFavorites",
				"title": "%lemari.commands.sortBySaved#sideBarFavorites.title%",
				"enablement": "lemari.sortBy != Saved"
			},
			{
				"command": "_lemari.sortByName#sideBarFavorites",
				"title": "%lemari.commands.sortByName#sideBarFavorites.title%",
				"enablement": "lemari.sortBy != Name"
			},
			{
				"command": "_lemari.sortByPath#sideBarFavorites",
				"title": "%lemari.commands.sortByPath#sideBarFavorites.title%",
				"enablement": "lemari.sortBy != Path"
			},
			{
				"command": "_lemari.sortByRecent#sideBarFavorites",
				"title": "%lemari.commands.sortByRecent#sideBarFavorites.title%",
				"enablement": "lemari.sortBy != Recent"
			},
			{
				"command": "lemari.filterProjectsByTag",
				"title": "%lemari.commands.filterProjectsByTag.title%"
			},
			{
				"command": "lemari.filterProjectsByTag#sideBar",
				"title": "%lemari.commands.filterProjectsByTag#sideBar.title%",
				"icon": "$(tag)"
			},
			{
				"command": "lemari.listFavoriteProjects#sideBarFavorites",
				"title": "%lemari.commands.listFavoriteProjects#sideBarFavorites.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.refreshProjects",
				"title": "%lemari.commands.refreshProjects.title%"
			},
			{
				"command": "lemari.refreshVSCodeProjects",
				"title": "%lemari.commands.refreshVSCodeProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "lemari.listVSCodeProjects#sideBarVSCode",
				"title": "%lemari.commands.listVSCodeProjects#sideBarVSCode.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.refreshGitProjects",
				"title": "%lemari.commands.refreshGitProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "lemari.addGitBaseFolder",
				"title": "%lemari.commands.addGitBaseFolder.title%",
				"icon": "$(new-folder)"
			},
			{
				"command": "lemari.listGitProjects#sideBarGit",
				"title": "%lemari.commands.listGitProjects#sideBarGit.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.refreshSVNProjects",
				"title": "%lemari.commands.refreshSVNProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "lemari.listSVNProjects#sideBarSVN",
				"title": "%lemari.commands.listSVNProjects#sideBarSVN.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.refreshAnyProjects",
				"title": "%lemari.commands.refreshAnyProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "lemari.listAnyProjects#sideBarAny",
				"title": "%lemari.commands.listAnyProjects#sideBarAny.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.refreshMercurialProjects",
				"title": "%lemari.commands.refreshMercurialProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "lemari.listMercurialProjects#sideBarMercurial",
				"title": "%lemari.commands.listMercurialProjects#sideBarMercurial.title%",
				"icon": "$(search)"
			},
			{
				"command": "lemari.openSettings#sideBarFavorites",
				"title": "%lemari.commands.openSettings#sideBarFavorites.title%"
			},
			{
				"command": "lemari.openSettings#sideBarVSCode",
				"title": "%lemari.commands.openSettings#sideBarVSCode.title%"
			},
			{
				"command": "lemari.openSettings#sideBarGit",
				"title": "%lemari.commands.openSettings#sideBarGit.title%"
			},
			{
				"command": "lemari.openSettings#sideBarSVN",
				"title": "%lemari.commands.openSettings#sideBarSVN.title%"
			},
			{
				"command": "lemari.openSettings#sideBarAny",
				"title": "%lemari.commands.openSettings#sideBarAny.title%"
			},
			{
				"command": "lemari.openSettings#sideBarMercurial",
				"title": "%lemari.commands.openSettings#sideBarMercurial.title%"
			},
			{
				"command": "_lemari.open",
				"title": "%lemari.commands.open.title%"
			},
			{
				"command": "_lemari.openInNewWindow",
				"title": "%lemari.commands.openInNewWindow.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "_lemari.openInWsl",
				"title": "%lemari.commands.openInWsl.title%"
			},
			{
				"command": "_lemari.openInWindows",
				"title": "%lemari.commands.openInWindows.title%"
			},
			{
				"command": "lemari.addToWorkspace#sideBar",
				"title": "%lemari.commands.addToWorkspace#sideBar.title%"
			},
			{
				"command": "_lemari.revealInFinder#sideBar",
				"title": "%lemari.commands.revealInFinder#sideBar.title%"
			},
			{
				"command": "_lemari.revealInExplorer#sideBar",
				"title": "%lemari.commands.revealInExplorer#sideBar.title%"
			},
			{
				"command": "_lemari.revealInFileManager#sideBar",
				"title": "%lemari.commands.revealInFileManager#sideBar.title%"
			},
			{
				"command": "lemari.addToWorkspace",
				"title": "%lemari.commands.addToWorkspace.title%"
			},
			{
				"command": "_lemari.deleteProject",
				"title": "%lemari.commands.deleteProject.title%"
			},
			{
				"command": "_lemari.renameProject",
				"title": "%lemari.commands.renameProject.title%"
			},
			{
				"command": "_lemari.editTags",
				"title": "%lemari.commands.editTags.title%"
			},
			{
				"command": "_lemari.editIcon",
				"title": "%lemari.commands.editIcon.title%"
			},
			{
				"command": "_lemari.editPath",
				"title": "%lemari.commands.editPath.title%"
			},
			{
				"command": "lemari.whatsNew",
				"title": "%lemari.commands.whatsNew.title%"
			},
			{
				"command": "_lemari.whatsNewContextMenu",
