			"view/item/context": [
				{
					"command": "_lemari.openInNewWindow",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "inline"
				},
				{
					"command": "_lemari.open",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_lemari.openInNewWindow",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_lemari.openInWsl",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation"
				},
				{
					"command": "_lemari.openInWindows",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation"
				},
				{
					"command": "_lemari.revealInFinder#sideBar",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isMac",
					"group": "navigation@2"
				},
				{
					"command": "_lemari.revealInExplorer#sideBar",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation@2"
				},
				{
					"command": "_lemari.revealInFileManager#sideBar",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isLinux",
					"group": "navigation@2"
				},
				{
					"command": "_lemari.deleteProject",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_lemari.renameProject",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_lemari.editTags",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_lemari.editIcon",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_lemari.editPath",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_lemari.toggleProjectEnabled",
					"when": "view == lemariExplorerFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "lemari.addToWorkspace#sideBar",
					"when": "view =~ /lemariExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "workspace"
				},
				{
					"command": "lemari.addToFavorites",
					"when": "view =~ /lemariExplorer(VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "workspace"
				}
			],
			"extension/context": [
				{
					"command": "_lemari.whatsNewContextMenu",
					"group": "lemari",
					"when": "extension == exeltarkus.lemari && extensionStatus == installed"
				}
			],
